# Copy to .env and replace every CHANGE_ME value. Docker Compose reads this file.
MYSQL_ROOT_PASSWORD=CHANGE_ME_unique_root_password
DB_PASSWORD=CHANGE_ME_unique_app_password
# Generate once: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_base64_32_random_bytes
ALLOWED_ORIGINS=http://localhost:8090
FRONTEND_URL=http://localhost:8090
MS_TENANT=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8090/api/outlook/callback

# Set to the existing volume name if you already deployed an earlier EventSync ZIP.
MYSQL_VOLUME_NAME=eventsync_mysql_data
# Optional, for public HTTPS deployment using compose.production.yaml.
# DOMAIN=eventsync.example.com
