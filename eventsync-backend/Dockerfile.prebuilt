# Precompiled alternative when you do not want Maven in your Docker build.
# app.jar is bundled in the release ZIP and includes V1/V2 Flyway migrations and the UI.
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY app.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java","-Duser.timezone=UTC","-jar","/app/app.jar"]
