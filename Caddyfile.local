:80 {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    handle /api/* {
        reverse_proxy api:8080
    }
    handle {
        root * /srv/figma
        try_files {path} /index.html
        file_server
    }
}
